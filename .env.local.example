# Copy this file to .env.local (already gitignored) and fill in a real key.
# Only used by scripts/generate-narration-variants.js so far.

# Pick ONE. If both are set, GEMINI_API_KEY wins (see resolveProvider() in
# the script). Gemini's free tier (aistudio.google.com) is the recommended
# default; OpenAI works too via the same OpenAI-compatible request shape.
GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# Optional overrides — each provider already has a sensible default model
# (gemini-3.6-flash / gpt-4o). Google renames/retires Gemini model ids more
# often than OpenAI does — if you get a 404 "model no longer available",
# check the error body (it names the current model) and update the default
# in resolveProvider() in the script, or override here.
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
